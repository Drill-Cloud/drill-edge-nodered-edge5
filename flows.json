    {
        "id": "66a364ee0ffe84d7",
        "type": "function",
        "z": "0ddaa4b089a41228",
        "name": "dev: эмуляция чтения",
        "func": "const CYCLE_MS = 10 * 60 * 1000;\nconst RAISE_S = 15;\nconst DRILL_S = 45;\nconst LOWER_S = 60;\nconst HOOK_MAX_M = 1.5;\nconst WEIGHT_MAX_KG = 40;\nconst ROTOR_RPM = 120;\nconst TICK_S = 5;\n\nfunction round(value) {\n    return Number(Number(value).toFixed(3));\n}\n\nfunction clamp(value, min, max) {\n    return Math.min(max, Math.max(min, value));\n}\n\nfunction lerp(a, b, t) {\n    return a + (b - a) * clamp(t, 0, 1);\n}\n\nfunction noise(amplitude) {\n    return (Math.random() * 2 - 1) * amplitude;\n}\n\nconst now = Date.now();\nlet t0 = context.get(\"t0\");\nif (!t0) {\n    t0 = now;\n    context.set(\"t0\", t0);\n}\n\nconst elapsedMs = (now - t0) % CYCLE_MS;\nconst t = elapsedMs / 1000;\n\nlet phase = \"idle\";\nif (t < RAISE_S) phase = \"raise\";\nelse if (t < DRILL_S) phase = \"drill\";\nelse if (t < LOWER_S) phase = \"lower\";\n\nlet wk = 0;\nlet hk = 0;\nlet nrot = 0;\nlet vsp = 0;\nlet pdk = 0;\nlet h2s = 0;\n\nif (phase === \"raise\") {\n    const p = t / RAISE_S;\n    hk = lerp(0, HOOK_MAX_M, p);\n    wk = lerp(0, WEIGHT_MAX_KG, p);\n    vsp = clamp(HOOK_MAX_M / RAISE_S + noise(0.02), 0, 1);\n} else if (phase === \"drill\") {\n    hk = HOOK_MAX_M + noise(0.01);\n    wk = WEIGHT_MAX_KG + noise(1);\n    nrot = ROTOR_RPM + noise(3);\n    vsp = 0;\n\n    let gas = context.get(\"gas\") || { pdk: 0.15, h2s: 0.15 };\n    gas.pdk = clamp(gas.pdk + noise(0.015), 0.1, 0.2);\n    gas.h2s = clamp(gas.h2s + noise(0.015), 0.1, 0.2);\n    context.set(\"gas\", gas);\n    pdk = gas.pdk;\n    h2s = gas.h2s;\n} else if (phase === \"lower\") {\n    const p = (t - DRILL_S) / (LOWER_S - DRILL_S);\n    hk = lerp(HOOK_MAX_M, 0, p);\n    wk = lerp(WEIGHT_MAX_KG, 0, p);\n    vsp = clamp(HOOK_MAX_M / (LOWER_S - DRILL_S) + noise(0.02), 0, 1);\n    nrot = 0;\n} else {\n    context.set(\"gas\", { pdk: 0.15, h2s: 0.15 });\n}\n\nlet wind = context.get(\"wind\");\nif (!wind) {\n    wind = {\n        value: Math.random() * 2,\n        target: Math.random() * 2,\n        nextChangeAt: now + (2 + Math.random() * 4) * 60 * 1000\n    };\n}\n\nif (now >= wind.nextChangeAt) {\n    wind.target = Math.random() * 2;\n    wind.nextChangeAt = now + (2 + Math.random() * 4) * 60 * 1000;\n}\n\n// ~полный диапазон за ~3 часа при тике 5 с\nconst windStep = (2 / (3 * 60 * 60)) * TICK_S;\nconst delta = wind.target - wind.value;\nif (Math.abs(delta) <= windStep) {\n    wind.value = wind.target;\n} else {\n    wind.value += Math.sign(delta) * windStep;\n}\nwind.value = clamp(wind.value, 0, 2);\ncontext.set(\"wind\", wind);\n\nmsg.payload = {\n    \"edge5-v3-wk\": round(wk),\n    \"edge5-v3-hk\": round(hk),\n    \"edge5-v3-vw\": round(wind.value),\n    \"edge5-v3-pdk\": round(pdk),\n    \"edge5-v3-h2s\": round(h2s),\n    \"edge5-v3-nrot\": round(nrot),\n    \"edge5-v3-vsp\": round(vsp)\n};\n\nconst cycleMin = Math.floor(t / 60);\nconst cycleSec = Math.floor(t % 60);\nnode.status({\n    fill: phase === \"idle\" ? \"blue\" : \"green\",\n    shape: \"dot\",\n    text: phase + \" \" + cycleMin + \":\" + String(cycleSec).padStart(2, \"0\")\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
